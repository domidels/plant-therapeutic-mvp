{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI (uvicorn) — debug",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--host", "0.0.0.0",
        "--port", "8000"
        // ⚠️ ne pas mettre --reload en mode debug
      ],
      "justMyCode": true,
      "console": "integratedTerminal",
      "env": {
        "PYTHONUNBUFFERED": "1",
        "NCBI_TOOL": "plant_mvp",
        "NCBI_EMAIL": "you@example.com"
      }
    }
  ]
}
